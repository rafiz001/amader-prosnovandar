{
  "name": "question-bank-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run wasm && vite",
    "build": "npm run wasm:release && vite build",
    "preview": "vite preview",
    "wasm": "node ../scripts/with-cargo.mjs wasm-pack build ../crates/wasm --target web --out-dir ../../frontend/src/wasm --dev",
    "wasm:release": "node ../scripts/with-cargo.mjs wasm-pack build ../crates/wasm --target web --out-dir ../../frontend/src/wasm --release"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "katex": "^0.16.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "wasm-pack": "^0.15.1"
  }
}
